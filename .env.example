# Server-only: tenant-scoped Bizosto API key for the canonical ERP lead-ingest endpoint.
# Production uses https://app.bizosto.com/api/ingest/leads. Preview/local must use an isolated app.
BIZOSTO_INGEST_ENDPOINT=
BIZOSTO_INGEST_API_KEY=

# Google reCAPTCHA v3. Production fails closed if the secret or allowed hostnames are absent.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=www.bizosto.com,bizosto.com
RECAPTCHA_MINIMUM_SCORE=0.5

# Optional. Analytics loads only after a visitor grants consent.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# Public, non-secret launch control. Enable only after the ERP public-signup gate is live-verified.
NEXT_PUBLIC_SELF_SERVICE_SIGNUP_ENABLED=false
